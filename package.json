{
  "name": "clink",
  "private": true,
  "version": "0.0.0",
  "description": "Clink monorepo: Expo app, shared rules package, Supabase backend.",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:shared": "jest --selectProjects shared",
    "test:app": "jest --selectProjects app",
    "test:db": "bash scripts/run-pgtap.sh",
    "check:gen": "npm run gen:check --workspace @clink/shared && npm run check:gen:android",
    "check:gen:android": "node scripts/gen-android-strings.mjs --check && node scripts/gen-android-colors.mjs --check && node scripts/gen-drink-assets.mjs --check",
    "check:icons": "node app/assets/art/icons/_source/check-icons.mjs",
    "test:art": "node --test scripts/gen-art-gallery.test.mjs",
    "test:scripts": "node --test scripts/gen-android.test.mjs scripts/supabase/supabase.test.mjs",
    "test:e2e:widget": "CLINK_E2E=1 jest -c e2e/widget-api/jest.config.js",
    "export:web": "npm run export:web --workspace @clink/app",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run check:gen && npm run check:icons && npm test && npm run test:art && npm run test:scripts"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
