<?xml version="1.0" encoding="utf-8"?>
<!-- A count line in numeral.l (DESIGN.md 2.4): "3 drinks" as one text with spans, the number in
     condensed bold and the word in medium at secondary size, so both sit on one baseline. No font
     padding, so the line is as tall as its digits. Glance Text can't do either. Size and spans are
     set per render (text scale cap). Screen readers read the block's contentDescription. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clink_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif-condensed"
    android:textColor="@color/clink_water_ink"
    android:textSize="34sp"
    android:fontFeatureSettings="tnum"
    android:includeFontPadding="false"
    android:lineSpacingMultiplier="1"
    android:importantForAccessibility="no"
    android:maxLines="1" />
