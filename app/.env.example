# Copy to .env.local. Only public values go here. Everything below ends up inside the app through
# app.config.ts `extra` (docs/ARCHITECTURE.md 8.5). Never put a secret key, service role key,
# JWT secret, database password, APNs key or pepper here: app.config.ts refuses an sb_secret_ key.
APP_VARIANT=dev

# Data layer: "supabase" (the default when a URL and key are known) or "mock" (in-memory, for the
# review build and unit tests).
CLINK_API=

# Public Supabase settings. Leave empty to use supabase/projects.json for APP_VARIANT
# (dev = clink-dev). Set both to point a build at another project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_SENTRY_DSN=
